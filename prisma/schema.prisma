generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  isAllowed     Boolean   @default(false)

  accounts      Account[]
  sessions      Session[]
  compensation  Compensation?
  kpiTasks      KpiTask[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- FIREMNÍ PARAMETRY (globální, sdílené) ---

model CompanyParameters {
  id                String @id @default("global")

  // Roční cílová odměna – vstupy
  currentEbitda     Float  @default(0)
  targetEbitda      Float  @default(0)
  currentHorizont   Float  @default(0)
  targetHorizont    Float  @default(0)

  // Phantom Option Plan – aktuální multiplier (admin mění dle výsledků)
  currentMultiplier Float  @default(6.0)
}

// --- ODMĚNA MANAŽERA ---

model Compensation {
  id                  String   @id @default(cuid())
  userId              String   @unique

  // Základní plat
  baseSalary          Float    @default(0)   // měsíční, CZK

  // Roční cílová odměna
  targetBonusAnnual   Float    @default(0)   // celková cílová odměna, CZK/rok
  bonusWeightEbitda   Float    @default(33)  // % složka závislá na EBITDA
  bonusWeightHorizont Float    @default(33)  // % složka závislá na HORIZONTu
  bonusWeightKpi      Float    @default(34)  // % složka závislá na KPI úkolech

  // Phantom Option Plan
  sharePercent        Float    @default(0)   // podíl v % z vytvořené hodnoty
  grantEbitda         Float    @default(0)   // EBITDA při vstupu do POP
  grantMultiplier     Float    @default(0)   // multiplier při vstupu do POP
  vestingYears        Int      @default(3)   // délka POP v letech
  grantDate           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- KPI ÚKOLY MANAŽERA ---

model KpiTask {
  id          String  @id @default(cuid())
  userId      String
  name        String
  weight      Float   @default(0)    // váha v rámci KPI složky (součet = 100%)
  isCompleted Boolean @default(false)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
