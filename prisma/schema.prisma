generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
}

// ─── UŽIVATELÉ A PŘÍSTUPY ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  isAllowed     Boolean   @default(false)
  password      String?
  divisionId    String?

  accounts      Account[]
  sessions      Session[]
  compensations Compensation[]
  kpiTasks      KpiTask[]
  snapshots     QuarterlySnapshot[]
  auditLogs     AuditLog[]
  division      Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─── DIVIZE ──────────────────────────────────────────────────────────────────

model Division {
  id          String  @id @default(cuid())
  name        String
  description String?
  users       User[]
  parameters  PerformanceParameter[]
}

// ─── ČASOVÉ OBDOBÍ ───────────────────────────────────────────────────────────

model Period {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  companyParams PerformanceParameter[]
  compensations Compensation[]
  kpiTasks      KpiTask[]
  boosters      StrategicBooster[]
  snapshots     QuarterlySnapshot[]
  vestingBase   VestingBase[]
}

// ─── VÝKONNOSTNÍ PARAMETRY (generické – EBITDA, HORIZONT, vlastní…) ──────────

// Definice parametru (šablona pro dané období)
model PerformanceParameter {
  id          String  @id @default(cuid())
  periodId    String
  divisionId  String?           // null = firemní (platí všem), set = jen pro tuto divizi
  name        String            // "EBITDA skupiny", "HORIZONT – Divize A"
  description String?           // textový popis metodiky výpočtu
  weight      Float             // váha v % z cílového bonusu (součet všech = 100)
  threshold   Float  @default(0) // bariéra: min % plnění – pod tím je složka = 0
  sortOrder   Int    @default(0)

  // Gating: pokud tento parametr nesplní threshold → gated parametr se nuluje
  // Příklad: EBITDA nesplní → HORIZONT se nuluje
  gatesParamId String?           // ID parametru který se nuluje při neúspěchu tohoto

  period     Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  division   Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  results    QuarterlyResult[]
}

// Kvartální výsledky na parametr
model QuarterlyResult {
  id          String    @id @default(cuid())
  parameterId String
  quarter     Int       // 1–4
  year        Int
  actual      Float     @default(0)  // skutečná hodnota
  target      Float     @default(0)  // cílová hodnota pro daný kvartal
  note        String?               // komentář
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  lockedByEmail String?

  parameter PerformanceParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  @@unique([parameterId, quarter, year])
}

// ─── POP – PHANTOM OPTION PLAN ───────────────────────────────────────────────

// Základní valuační data pro POP (globální, per období)
model VestingBase {
  id              String @id @default(cuid())
  periodId        String @unique
  baseMultiplier  Float  @default(6.0)  // základní koeficient
  currentEbitda   Float  @default(0)    // aktuální EBITDA pro výpočet hodnoty firmy

  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

// Strategické boostery – navyšují valuační koeficient
model StrategicBooster {
  id              String    @id @default(cuid())
  periodId        String
  name            String
  description     String?   // podmínky, co musí nastat, jak se měří
  multiplierBoost Float     // o kolik navýší koeficient (např. +0.5)
  isAchieved      Boolean   @default(false)
  achievedAt      DateTime?
  achievedQuarter Int?      // Q1–Q4
  achievedYear    Int?

  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

// ─── ODMĚNA MANAŽERA (smluvní podmínky) ─────────────────────────────────────

model Compensation {
  id                String   @id @default(cuid())
  userId            String
  periodId          String

  // Fixní složka
  baseSalary        Float    @default(0)   // měsíční plat CZK

  // Variabilní složka
  targetBonusAnnual Float    @default(0)   // roční cílový bonus CZK
  kpiWeight         Float    @default(0)   // % z bonusu tvořené KPI složkou (0 = KPI nehraje roli)

  // POP
  sharePercent      Float    @default(0)   // podíl v % z vytvořené hodnoty
  grantEbitda       Float    @default(0)   // EBITDA při vstupu do POP
  grantMultiplier   Float    @default(0)   // multiplikátor při vstupu do POP
  grantDate         DateTime @default(now())

  // Vesting
  vestingYears      Int      @default(4)   // celková délka vestingu
  vestingPercent    Float    @default(25)  // % z hodnoty POP ročně

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  period   Period           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  payments VestingPayment[]

  @@unique([userId, periodId])
}

// Vesting – splátky POP
model VestingPayment {
  id             String    @id @default(cuid())
  compensationId String
  vestingYear    Int       // rok od grantu: 1, 2, 3, 4…
  percentage     Float     // % z celkové hodnoty POP
  isPaid         Boolean   @default(false)
  paidAt         DateTime?
  amount         Float?    // skutečně vyplacená částka CZK

  compensation Compensation @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  @@unique([compensationId, vestingYear])
}

// ─── KPI ÚKOLY (individuální) ────────────────────────────────────────────────

model KpiTask {
  id            String    @id @default(cuid())
  userId        String
  periodId      String
  name          String
  description   String?
  weight        Float     @default(0)        // váha v % (součet = 100)
  taskType      String    @default("BOOLEAN") // BOOLEAN | PERCENT | AMOUNT
  isCompleted   Boolean   @default(false)    // pro BOOLEAN
  completedAt   DateTime?
  completionPct Float?                        // pro PERCENT (0–100)
  targetAmount  Float?                        // pro AMOUNT – plán
  actualAmount  Float?                        // pro AMOUNT – skutečnost

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

// ─── HISTORICKÉ SNAPSHOTY (uzavřený kvartál) ─────────────────────────────────

model QuarterlySnapshot {
  id          String   @id @default(cuid())
  userId      String
  periodId    String
  quarter     Int      // 1–4
  year        Int
  bonusAmount Float    @default(0)  // bonus připsaný za tento kvartal
  popValue    Float    @default(0)  // hodnota POP v okamžiku uzavření
  breakdown   Json?                 // detailní breakdown pro graf

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)
  @@unique([userId, periodId, quarter, year])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userEmail String   // kdo provedl změnu
  action    String   // "UPDATE_COMPENSATION", "LOCK_QUARTER", "ADD_BOOSTER"…
  target    String?  // "Compensation:clxxx", "QuarterlyResult:clyyy"
  oldValue  String?  @db.Text  // JSON před změnou
  newValue  String?  @db.Text  // JSON po změně
  createdAt DateTime @default(now())

  user User @relation(fields: [userEmail], references: [email])
}
